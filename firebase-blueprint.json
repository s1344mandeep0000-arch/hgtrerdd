{
  "entities": {
    "ModProject": {
      "title": "ModProject",
      "description": "A user-authored Java Edition mod or Bedrock Edition add-on project generated by CraftForge Studio.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "description": "Display title of the mod or add-on project."
        },
        "modId": {
          "type": "string",
          "description": "Normalized lowercase identifier or pack namespace."
        },
        "edition": {
          "type": "string",
          "enum": ["JAVA", "BEDROCK"],
          "description": "Minecraft edition engine used to generate this project."
        },
        "targetVersionId": {
          "type": "string",
          "description": "Catalog ID of the targeted Minecraft version."
        },
        "targetVersionNumber": {
          "type": "string",
          "description": "Exact version string targeted (e.g., 1.20.1, 26.3, 26.63)."
        },
        "selectedLoader": {
          "type": "string",
          "description": "Mod loader or runtime (Forge, NeoForge, Fabric, Script API, Native Add-on)."
        },
        "featureCategory": {
          "type": "string",
          "description": "Primary content category (Block, Item, Weapon, Entity, Dimension, Structure, Recipe, Loot Table, Full Pack)."
        },
        "prompt": {
          "type": "string",
          "description": "Creator prompt used to generate the project."
        },
        "adaptationNotes": {
          "type": "string",
          "description": "Version-specific technical adaptation notes and compatibility guidance."
        },
        "validationStatus": {
          "type": "string",
          "enum": ["COMPATIBLE", "PARTIALLY_COMPATIBLE", "REQUIRES_MODIFICATION", "NOT_SUPPORTED"],
          "description": "Latest pre-export validation status."
        },
        "validationSummary": {
          "type": "string",
          "description": "Human-readable validation report summary."
        },
        "fileCount": {
          "type": "integer",
          "description": "Number of generated files in the project."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "modId",
        "edition",
        "targetVersionId",
        "targetVersionNumber",
        "selectedLoader",
        "featureCategory",
        "prompt",
        "adaptationNotes",
        "validationStatus",
        "validationSummary",
        "fileCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectFile": {
      "title": "ProjectFile",
      "description": "An individual generated code, JSON, manifest, or base64 PNG texture file within a ModProject.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "projectId": {
          "type": "string",
          "description": "Parent ModProject document ID."
        },
        "path": {
          "type": "string",
          "description": "Relative archive path of the generated file."
        },
        "content": {
          "type": "string",
          "description": "UTF-8 source/JSON text or Base64-encoded PNG image bytes."
        },
        "fileType": {
          "type": "string",
          "description": "Logical file category (JAVA, GRADLE, TOML, JSON, JS, PNG, TEXT)."
        },
        "binaryAsset": {
          "type": "boolean",
          "description": "True when content contains Base64-encoded binary PNG texture bytes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "projectId",
        "path",
        "content",
        "fileType",
        "binaryAsset",
        "createdAt",
        "updatedAt"
      ]
    },
    "VersionCatalogUpdate": {
      "title": "VersionCatalogUpdate",
      "description": "A dynamically added or updated Minecraft version entry stored without rebuilding the app.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "versionId": {
          "type": "string",
          "description": "Unique version entry identifier."
        },
        "edition": {
          "type": "string",
          "enum": ["JAVA", "BEDROCK"],
          "description": "Edition identifier."
        },
        "versionNumber": {
          "type": "string",
          "description": "Version number string."
        },
        "updateName": {
          "type": "string",
          "description": "Official update or drop title."
        },
        "releaseDate": {
          "type": "string",
          "description": "ISO release date (YYYY-MM-DD)."
        },
        "sortOrder": {
          "type": "integer",
          "description": "Chronological integer sort key."
        },
        "historicalCategory": {
          "type": "string",
          "description": "Historical era category."
        },
        "releaseType": {
          "type": "string",
          "description": "Release classification (Release, Alpha, Beta, Snapshot, Hotfix)."
        },
        "compatibilityStatus": {
          "type": "string",
          "enum": ["COMPATIBLE", "PARTIALLY_COMPATIBLE", "REQUIRES_MODIFICATION", "NOT_SUPPORTED"],
          "description": "Modding compatibility status."
        },
        "supportedCapabilities": {
          "type": "string",
          "description": "Comma-delimited or structured capability tags."
        },
        "compatibleLoaders": {
          "type": "string",
          "description": "Comma-delimited compatible mod loaders."
        },
        "supportedFileFormats": {
          "type": "string",
          "description": "Comma-delimited supported output formats."
        },
        "requiredRuntime": {
          "type": "string",
          "description": "Required Java/Script runtime or pack format."
        },
        "adaptationNotes": {
          "type": "string",
          "description": "Version-specific technical notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "versionId",
        "edition",
        "versionNumber",
        "updateName",
        "releaseDate",
        "sortOrder",
        "historicalCategory",
        "releaseType",
        "compatibilityStatus",
        "supportedCapabilities",
        "compatibleLoaders",
        "supportedFileFormats",
        "requiredRuntime",
        "adaptationNotes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/ModProject"
      },
      "description": "User-owned generated Java Edition mods and Bedrock Edition add-ons."
    },
    "/users/{userId}/projects/{projectId}/files/{fileId}": {
      "schema": {
        "$ref": "#/entities/ProjectFile"
      },
      "description": "Individual generated source, JSON, manifest, and texture files belonging to a ModProject."
    },
    "/users/{userId}/version_updates/{versionId}": {
      "schema": {
        "$ref": "#/entities/VersionCatalogUpdate"
      },
      "description": "User-synced dynamic Minecraft version catalog additions allowing catalog updates without APK rebuilds."
    }
  }
}
